# Copy to .env only to override the compose defaults. Nothing here is required:
# `docker compose up` works with no .env at all.

# Accepts either a libpq URL (what every managed host hands out) or a JDBC one.
DATABASE_URL=postgresql://wallet:wallet@localhost:5432/wallet

# Shared secret for POST /admin/mint (test funding). Change it for any
# deployment you care about.
ADMIN_TOKEN=dev-admin-token

PORT=8080
LOG_LEVEL=INFO

# Connection pool. Keep this well under the database's max_connections,
# especially on a free tier where that ceiling is low.
DB_MAX_CONNS=20
DB_MIN_CONNS=2
